# 运行期与缓存（数据源不在此列，全部入库）
.venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
.codebuddy/

# 密钥：任何情况下都不入库
.env
local-config/

# 运行产物（可由代码重新生成，不属于数据源）
