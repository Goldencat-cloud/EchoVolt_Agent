pipeline/service/.sandbox-tmp/
pipeline/service/.local/
pipeline/service/*.log
pipeline/service/*.log.*
pipeline/service/_tmp_*.py
pipeline/service/_t*.txt
pipeline/service/_test_out.txt
pipeline/service/data/e2e-runs/
pipeline/service/data/_e2e_logs/
pipeline/data/runtime/
pipeline/data/stock/db/backup-*/

