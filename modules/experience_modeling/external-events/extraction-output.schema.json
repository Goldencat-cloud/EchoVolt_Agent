{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/automotive-external-event-output-v0.1.0.json",
  "title": "External Event Extraction Output v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "external_events"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "external_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external_event_record"
      }
    }
  },
  "$defs": {
    "external_event_record": {
      "title": "Automotive External Event Record MVP v0.1.0",
      "description": "An evidence-grounded external event claim, independent of user experience. Extraction is not independent fact verification.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "statement_type",
        "description",
        "evidence",
        "verification_status",
        "extraction_confidence"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique event record ID generated by the pipeline; not an inferred link to a canonical timeline event."
        },
        "event_type": {
          "type": "string",
          "enum": [
            "product_launch",
            "price_adjustment",
            "recall",
            "software_update",
            "safety_incident",
            "policy_regulation",
            "company_change",
            "production_delivery",
            "competition_market",
            "infrastructure_change",
            "weather_disaster",
            "other",
            "unknown"
          ],
          "description": "Project taxonomy for event kind; use other or unknown without inventing labels."
        },
        "statement_type": {
          "enum": [
            "reported",
            "announced",
            "planned",
            "rumor",
            "disputed",
            "unclear"
          ],
          "description": "How the input presents the event, not whether it is true. Pure personal conditional worries are experiences, not actual external events."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Neutral source-attributed event description. Preserve uncertainty, negation and disagreements; do not infer causation or user impact."
        },
        "actor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Actor explicitly identified in the input; omit or null if not stated."
        },
        "product_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Only IDs supplied in the input and reliably resolved; product/brand words alone do not authorize generating IDs."
        },
        "event_time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_text",
            "value",
            "precision"
          ],
          "properties": {
            "raw_text": {
              "type": "string",
              "minLength": 1,
              "description": "Exact original time expression; never substitute post publication time."
            },
            "value": {
              "type": [
                "string",
                "null"
              ],
              "description": "ISO normalized value only when supported; null when a year/timezone or other necessary component is absent."
            },
            "precision": {
              "enum": [
                "year",
                "month",
                "day",
                "datetime",
                "unknown"
              ],
              "description": "Source time granularity; missing normalization components do not authorize invention."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "precision": {
                    "const": "year"
                  }
                },
                "required": [
                  "precision"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^\\d{4}$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "precision": {
                    "const": "month"
                  }
                },
                "required": [
                  "precision"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "precision": {
                    "const": "day"
                  }
                },
                "required": [
                  "precision"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "precision": {
                    "const": "datetime"
                  }
                },
                "required": [
                  "precision"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])[Tt]([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?([Zz]|[+-]([01]\\d|2[0-3]):[0-5]\\d)$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "precision": {
                    "const": "unknown"
                  }
                },
                "required": [
                  "precision"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "quote"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1,
              "description": "ID of the source post/comment in the evidence store."
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "description": "Exact source excerpt supporting this record."
            }
          }
        },
        "verification_status": {
          "const": "unverified",
          "description": "This post-only extraction does not independently verify events; source authority or model confidence cannot promote this value."
        },
        "extraction_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Model-estimated confidence in the correctness of the structured event extraction, not the probability that the event is objectively true. Use for prioritizing review; calibrate against human annotations before treating as probabilistic."
        }
      }
    }
  }
}
