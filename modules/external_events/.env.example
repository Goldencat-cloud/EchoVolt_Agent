# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，严禁入库）

# ── 火山引擎搜索（必填；也支持官方 MCP 的 ASK_ECHO_SEARCH_INFINITY_API_KEY）──
VOLCENGINE_SEARCH_API_KEY=
VOLCENGINE_SEARCH_API_URL=https://open.feedcoopapi.com/search_api/web_search
# 单客户端请求启动间隔（秒），默认0.65，适配默认100 QPM；多进程需共享配额预算。
VOLCENGINE_SEARCH_INTERVAL=0.65

# ── LLM（可选但强烈建议；缺失时工具自动降级为"取最优来源原句"）──
# 兼容 OpenAI 的 chat 端点，用于事件改写/分类与条级去噪
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL=

# ── Embedding 模型（可选；不配则用内置字符 n-gram TF 余弦，零依赖且确定性）──
# 例（硅基流动）：EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#               EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ── LangSmith 可观测性（可选）──
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=

# 可选产物目录；本地启动脚本使用 .local/research，避免覆盖旧示例
TIMELINE_OUTPUT_DIR=
