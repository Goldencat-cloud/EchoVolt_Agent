{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SingleImageUnderstandingResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["image_id", "image_type", "summary", "vehicle_identification", "potential_evidence_value", "confidence"],
  "properties": {
    "image_id": {"type": "string", "minLength": 1},
    "image_type": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "vehicle_identification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "model", "identification_basis"],
      "properties": {
        "brand": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "identification_basis": {"type": ["string", "null"]}
      }
    },
    "potential_evidence_value": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "evidence", "limitation"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "evidence": {"type": "string"},
          "limitation": {"type": "string"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
