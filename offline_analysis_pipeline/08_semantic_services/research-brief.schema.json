{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "catalog_version", "brief_id", "title", "questions", "metrics", "dimensions", "default_aspect", "minimum_posts", "required_evidence", "required_sections", "coverage_notice"],
  "properties": {
    "schema_version": {"const": "research-brief-3"},
    "catalog_version": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["negativeShare", "posts", "negative_posts", "claims", "negative"]}},
    "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["aspect", "sentiment", "journey", "ownership", "product", "time"]}},
    "default_aspect": {"type": ["string", "null"]},
    "minimum_posts": {"type": "integer", "minimum": 1},
    "required_evidence": {"type": "array", "items": {"enum": ["quote", "url", "claim_id", "data_version"]}},
    "required_sections": {"type": "array", "items": {"enum": ["observation", "comparison", "evidence", "interpretation", "limitations", "next_questions"]}},
    "coverage_notice": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
