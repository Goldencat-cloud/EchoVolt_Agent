{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AUTO-007 enhanced single-image result (model output, no image_id)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image_type",
    "summary",
    "vehicle_identification",
    "potential_evidence_value",
    "confidence",
    "context_assessment"
  ],
  "properties": {
    "image_type": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "vehicle_identification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "model", "identification_basis"],
      "properties": {
        "brand": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "identification_basis": { "type": ["string", "null"] }
      }
    },
    "potential_evidence_value": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "evidence", "limitation"],
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string" },
          "limitation": { "type": ["string", "null"] }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "context_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_relevance", "context_role", "cited_fragments", "limitations", "requested_expansion"],
      "properties": {
        "context_relevance": { "enum": ["有关", "无关", "证据不足"] },
        "context_role": { "type": ["string", "null"] },
        "cited_fragments": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": ["string", "null"] },
        "requested_expansion": { "type": "boolean" },
        "expansion_gap": { "type": ["string", "null"] },
        "expansion_query": { "type": ["string", "null"] }
      }
    }
  }
}
