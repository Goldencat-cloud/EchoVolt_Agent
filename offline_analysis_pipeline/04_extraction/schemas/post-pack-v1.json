                  "外观与内饰",
                  "动力与性能",
                  "安全与质量",
                  "可靠性与故障",
                  "价格与成本",
                  "配置与功能",
                  "服务与交付",
                  "品牌与口碑",
                  "技术原理",
                  "政策与市场",
